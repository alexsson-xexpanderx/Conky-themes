-- Size of the conky window in pixels. The widget centres itself in here and
-- scales down if it does not fit, so raise this if lua_widgets.lua logs that it
-- wanted more room (32 temperature bars need about 1000, which is why this is the default).
local size = 1000

conky.config = {
	background = false,
	update_interval = 1,

	override_utf8_locale = true,

	double_buffer = true,
	no_buffers = true,

	text_buffer_size = 2048,
	imlib_cache_size = 0,


	own_window = true,
	own_window_type = 'normal',
	own_window_colour = '#00000000',
--	own_window_class = 'conky-semi',
	own_window_hints = 'undecorated,below,sticky,skip_taskbar,skip_pager',

	border_inner_margin = 0,
	border_outer_margin = 0,

	minimum_width = size, minimum_height = size,


	alignment = 'middle_middle',
	gap_x = 0,
	gap_y = 0,

	draw_shades = true,
	draw_outline = false,
	draw_borders = false,
	draw_graph_borders = false,

	use_xft = true,
	font = 'pftempestafivecondensed:size=6',
	xftalpha = 0.5,

	uppercase = false,

	default_color = '#FFFFFF',

	lua_load = 'lua_widgets.lua',
	lua_draw_hook_pre = 'start_widgets',
};

conky.text = [[
${color FFFFFF}
]];
