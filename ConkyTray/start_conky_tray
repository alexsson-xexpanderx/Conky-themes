--[[
  ConkyTray: the panel's window. The panel itself is drawn by tray.lua.

  Start it with:  conky -c /path/to/ConkyTray/start_conky_tray
]]

-- Which edge of the screen it goes along: "bottom", "top", "left" or
-- "right". On the left or right it stands upright.
local position = "bottom"

-- How thick the panel is, in your screen's units (its height, or its width
-- when it stands upright): the bar is four fifths of it, with a little room
-- either side.
local height = 56

-- How far past the screen's edge the window reaches, in the same units. With
-- a desktop scale like 115% the screen is not a whole number of units tall
-- and a panel ending exactly at it left a line of wallpaper showing. tray.lua
-- draws the panel inside the rest (its OVERHANG must say the same).
local overhang = 1

---------------------------------------------------------------------------

local function command(text)
    local pipe = io.popen(text .. " 2>/dev/null")
    if not pipe then return "" end
    local out = pipe:read("a") or ""
    pipe:close()
    return out
end

local here = debug.getinfo(1, "S").source:match("^@(.*)/[^/]*$") or "."

-- As long as the screen's edge. Wayland places windows in units of the
-- screen's pixels over its scale, so the helper works that out.
local screen = {}
for n in command("python3 '" .. here .. "/tray.py' screen"):gmatch("[%d.]+") do screen[#screen + 1] = tonumber(n) end
local screen_w, screen_h = screen[1] or 1920, screen[4] or 1080
local upright = position == "left" or position == "right"
local width = upright and height + overhang or screen_w
local length = upright and screen_h or height + overhang
-- The panel keeps the space along its edge for itself; conky takes the edge
-- from the alignment (middle_left keeps the left edge, and so on).
local alignment = ({bottom = 'bottom_left', top = 'top_left', left = 'middle_left',
                    right = 'middle_right'})[position] or 'bottom_left'

local major, minor = command("conky --version"):match("conky (%d+)%.(%d+)")
local version = (tonumber(major) or 1) * 100 + (tonumber(minor) or 25)

conky.config = {
    -- Wayland, where a panel can keep windows from covering it (the layer
    -- shell's exclusive zone). Through XWayland, KWin ignores the request.
    output_backend = 'wayland',

    -- Five times a second: the clock, hover and clicks need no more, and
    -- every redraw costs conky the whole panel.
    update_interval = 0.2,
    double_buffer = true,
    no_buffers = true,
    override_utf8_locale = true,
    text_buffer_size = 256,

    own_window = true,
    own_window_title = 'conky-tray',
    own_window_type = 'panel',

    border_width = 0,
    border_inner_margin = 0,
    border_outer_margin = 0,

    minimum_width = width,
    maximum_width = width,
    minimum_height = length,

    alignment = alignment,
    -- The overhang: a negative margin puts that much of the window past the
    -- edge. KWin takes the margin off the space it keeps for the panel too,
    -- so windows reach just under the panel and no seam shows between them.
    gap_x = upright and -overhang or 0,
    gap_y = upright and 0 or -overhang,

    draw_shades = false,
    draw_outline = false,
    draw_borders = false,
    draw_graph_borders = false,

    lua_load = 'tray.lua',
    lua_draw_hook_pre = 'tray',
    lua_mouse_hook = 'tray_mouse',
}

if version >= 125 then
    conky.config.own_window_color = '#00000000'
else
    conky.config.own_window_colour = '#00000000'
end

conky.text = [[]]
